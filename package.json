{
  "name": "3d-render",
  "productName": "3D RENDER",
  "version": "1.0.0",
  "description": "매장 · 주방 도면 편집과 3D 렌더",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --publish never",
    "android:add": "cap add android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mystore.threedrender",
    "productName": "3D RENDER",
    "files": ["electron/**", "www/**"],
    "directories": { "output": "dist" },
    "win": { "target": ["portable"] }
  }
}
