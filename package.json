{
  "name": "byr-next",
  "productName": "BYR Next",
  "version": "0.1.0",
  "description": "Build Your Restaurant — Three.js 실사 렌더 · 태블릿 UI 신규 빌드",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "vendor": "node scripts/vendor.js",
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "android:apk": "cap add android && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {},
  "devDependencies": {
    "three": "0.170.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "build": {
    "appId": "com.byr.next",
    "files": [
      "electron/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "productName": "BYR Next"
  }
}
