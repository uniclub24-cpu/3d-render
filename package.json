{
  "name": "byr-next",
  "productName": "BYR2",
  "version": "2.1.11",
  "description": "BYR Next 2.1 — 2D↔3D · 보기 스타일 · 구배 · 공간 태그 · 디자인 수정 · 배경 · 자동 저장/동기화",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/vendor.js",
    "vendor": "node scripts/vendor.js",
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "android:apk": "cap add android && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {},
  "devDependencies": {
    "three": "0.170.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/assets": "^3.0.5"
  },
  "build": {
    "appId": "com.byr.next",
    "files": [
      "electron/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "productName": "BYR2"
  }
}
